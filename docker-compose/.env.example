# Copy to docker-compose/.env and replace every example-only value before use.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=common.yml:kafka_cluster.yml:elastic_cluster.yml:redis_cluster.yml:monitoring.yml:zipkin.yml:services.yml

KAFKA_VERSION=7.0.1
ELASTIC_VERSION=7.17.6
KEYCLOAK_VERSION=15.0.2
REDIS_VERSION=6.2.6
GRAFANA_VERSION=9.1.5
PROMETHEUS_VERSION=v2.39.0
ZIPKIN_VERSION=2.23
SERVICE_VERSION=latest
GLOBAL_NETWORK=application
GROUP_ID=com.microservices.demo

CONFIG_SERVER_PASSWORD=example-only-config-server-password
ENCRYPT_KEY=example-only-encryption-key
TWITTER_BEARER_TOKEN=example-only-twitter-bearer-token
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=example-only-keycloak-admin-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=example-only-keycloak-db-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=example-only-grafana-admin-password
ANALYTICS_DB_PASSWORD=example-only-analytics-db-password
ELASTIC_QUERY_CLIENT_SECRET=example-only-elastic-query-client-secret
ELASTIC_QUERY_DB_PASSWORD=example-only-elastic-query-db-password
ELASTIC_QUERY_USER_PASSWORD=example-only-elastic-query-user-password
ELASTIC_QUERY_WEB_CLIENT_SECRET=example-only-elastic-query-web-client-secret
ELASTIC_QUERY_WEB_CLIENT_2_SECRET=example-only-elastic-query-web-client-2-secret
